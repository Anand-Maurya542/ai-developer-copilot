{
  "name": "ai-developer-copilot-root",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Developer Copilot monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspace=@copilot/web dev",
    "dev:api": "npm --workspace=@copilot/api run dev",
    "dev:web": "npm --workspace=@copilot/web run dev",
    "build": "npm run --workspaces --if-present build",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test",
    "test:unit": "npm run --workspaces --if-present test:unit",
    "test:integration": "npm run --workspaces --if-present test:integration",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "db:migrate": "npm --workspace=@copilot/database run migrate",
    "db:seed": "npm --workspace=@copilot/database run seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=20.0.0"
  }
}

