# AI Developer Copilot Environment Configuration Baseline
# Copy this file to .env and replace placeholders with real values for your environment.

# ==============================================================================
# Environment & Server
# ==============================================================================
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# ==============================================================================
# Authentication & Sessions (IAM-01)
# ==============================================================================
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min32chars
SESSION_EXPIRY_SECONDS=86400

# ==============================================================================
# Database & Cache (PostgreSQL 16 + pgvector, Redis)
# ==============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/copilot_dev
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# GitHub Integration (GH-01, GH-02, GH-03)
# ==============================================================================
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.test_client_id
GITHUB_APP_CLIENT_SECRET=test_client_secret
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=test_webhook_secret_needs_to_be_secure_and_unpredictable

# ==============================================================================
# AI Provider Gateway (RAG-01, ADR-006)
# ==============================================================================
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=mock-or-actual-provider-key
AI_MODEL_ID=gpt-4o-mini
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_DIM=1536

# ==============================================================================
# S3 / MinIO Object Storage (Archives & Manifests)
# ==============================================================================
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=copilot-artifacts
OBJECT_STORAGE_REGION=us-east-1

# ==============================================================================
# Worker & Ingestion Configuration (IDX-01 .. IDX-05)
# ==============================================================================
MAX_CONCURRENT_CHUNKS=20
MAX_FILE_SIZE_BYTES=1048576 # 1 MB maximum per file
WORKER_CONCURRENCY=5
EMBEDDING_BATCH_SIZE=64
